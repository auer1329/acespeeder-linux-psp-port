# PSP build: make -f Makefile.psp [APP=game|viewer|trackview]
# Produces EBOOT.PBP. tools/make_dist.sh builds the game and assembles the folder
# to copy to ms0:/PSP/GAME/AceSpeeder/ with the converted data.
APP ?= game
TARGET = $(APP)

ENGINE_OBJS = src/engine/rmath.o src/engine/xfile.o src/engine/image.o src/engine/rm.o \
              src/engine/font.o src/engine/sprite.o \
              src/platform/mixer.o src/platform/clip.o src/platform/psp/plat_psp.o

GAME_OBJS = src/game/gmath.o src/game/track.o src/game/machine.o src/game/camera.o src/game/sound.o \
            src/game/effects.o src/game/hud.o src/game/race.o src/game/save.o src/game/replay.o \
            src/game/fx.o src/game/scene.o src/game/course_objects.o src/game/doors.o src/game/title.o src/game/menu.o src/game/ending.o src/game/settings.o

ifeq ($(APP),viewer)
APP_OBJS = src/tools/viewer.o
endif
ifeq ($(APP),game)
APP_OBJS = src/main.o $(GAME_OBJS)
endif
ifeq ($(APP),trackview)
APP_OBJS = src/tools/trackview.o $(GAME_OBJS)
endif

OBJS = $(APP_OBJS) $(ENGINE_OBJS)

INCDIR =
CFLAGS = -O2 -G0 -Wall -std=gnu99 -ffp-contract=off
CXXFLAGS = $(CFLAGS)
ASFLAGS = $(CFLAGS)
LIBDIR =
LDFLAGS =
LIBS = -lpspgum -lpspgu -lpspdmac -lpsputility -lpspaudiolib -lpspaudio -lpsppower -lpsprtc -lm

EXTRA_TARGETS = EBOOT.PBP
ifeq ($(APP),game)
PSP_EBOOT_TITLE = AceSpeeder!
PSP_EBOOT_ICON = $(wildcard ICON0.PNG)
PSP_EBOOT_PIC1 = $(wildcard PIC1.PNG)
else
PSP_EBOOT_TITLE = AceSpeeder! ($(APP))
endif

PSPSDK = $(shell psp-config --pspsdk-path)
include $(PSPSDK)/lib/build.mak

src/platform/mixer.o: CFLAGS += -w
